#!/bin/sh
# commit-msg hook — message-diff congruence (R72; v3 at e323's fold)
# Rejects the incident classes of 2026-10-09:
#   (a) PHANTOM: a message clause claiming "TOKEN ... FOLDED/COMPLETE/DONE" with NO ledger
#       file staged (v1: same-line; v2: same-clause + required the token's own path — too
#       strict: heartbeat folds legitimately stage only ledger files since executors commit
#       their own artifacts; v3: a fold claim requires at least one of NOTES/THINKING/
#       REVIEWS/QUEUE/STATE/DAY_* staged). Would have rejected 8aba9ce either way.
#   (b) SILENT-BIRTH: a staged lab/eNNN*/xNNN* or runs/eNNN//xNNN/ path whose token the
#       message never names (unchanged; caught the e318 and e323-PNG races).
# Local passive guard; bypass with --no-verify AND a disclosure in the message.
MSG="$1"
die() { echo "commit-msg congruence: $1" >&2; echo "(bypass: --no-verify + disclose)" >&2; exit 1; }

STAGED=$(git diff --cached --name-only)

# (a) phantom folds: a fold claim needs a ledger file staged
if echo "$MSG" | sed -e 's/[;.!]/\n/g' | grep -iE '\b[ex][0-9]{3}\b' | grep -qiE 'folded|complete|done'; then
  echo "$STAGED" | grep -qE '^(NOTES\.md|THINKING\.md|REVIEWS\.md|QUEUE\.md|STATE\.json|DAY_[A-Z]+_REPORT\.md)$' \
    || die "message claims a cell folded/complete but no ledger file (NOTES/THINKING/REVIEWS/QUEUE/STATE/DAY_*) staged"
fi

# (b) staged experiment paths must be named somewhere in the message
for p in $(echo "$STAGED" | grep -E '^(lab|runs)/(e|x)[0-9]{2,3}'); do
  tok=$(echo "$p" | grep -oE '(e|x)[0-9]{2,3}' | head -1)
  [ -n "$tok" ] && ! grep -qiE "\b$tok\b" "$MSG" && die "staged $p but message never names $tok"
done
exit 0
